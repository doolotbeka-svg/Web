// Prisma Schema for Universal Retail POS System (OmniPOS)
// Compatible with PostgreSQL & CockroachDB

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  BONUSES
  MIXED
  TRANSFER
  QR
}

enum OrderStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  HELD
  CANCELLED
}

enum MovementType {
  RECEIPT       // Приход от поставщика
  WRITE_OFF     // Списание / бой / брак
  TRANSFER_IN   // Перемещение входящее
  TRANSFER_OUT  // Перемещение исходящее
  INVENTORY_ADJ // Корректировка по инвентаризации
  SALE          // Списание по чеку
  RETURN        // Возврат покупателя
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Store {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  address        String?
  phone          String?
  taxNumber      String?         // ИНН / ОГРН
  currency       String          @default("RUB")
  defaultTaxRate Float           @default(20.0) // НДС %
  headerNotice   String?         // Текст в шапке чека
  footerNotice   String?         // Текст в подвале чека (Спасибо за покупку!)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  users          User[]
  inventory      InventoryItem[]
  orders         Order[]
  shifts         Shift[]
  movements      StockMovement[]

  @@map("stores")
}

model User {
  id           String      @id @default(cuid())
  storeId      String?
  name         String
  email        String      @unique
  pinCode      String      // 4-значный ПИН-код для быстрой авторизации на кассе
  role         Role        @default(CASHIER)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  store        Store?      @relation(fields: [storeId], references: [id])
  orders       Order[]
  shifts       Shift[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parentId    String?
  color       String?    @default("#3b82f6") // Для цветовой дифференциации плиток
  icon        String?
  order       Int        @default(0)

  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]

  @@map("categories")
}

model Product {
  id            String           @id @default(cuid())
  categoryId    String
  name          String
  sku           String           @unique
  barcode       String?          @unique
  description   String?
  unit          String           @default("pcs") // pcs (шт), kg (кг), l (л), pack (уп)
  costPrice     Float            // Закупочная цена
  salePrice     Float            // Розничная цена
  minStockAlert Float            @default(5)
  hasVariants   Boolean          @default(false)
  image         String?
  taxRate       Float            @default(20.0)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  inventory     InventoryItem[]
  orderItems    OrderItem[]
  movements     StockMovement[]

  @@map("products")
}

model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  name          String          // "Красный / XL" или "0.5 л"
  sku           String          @unique
  barcode       String?         @unique
  costPrice     Float?
  salePrice     Float
  attributes    Json?           // {"color": "Red", "size": "XL"}

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     InventoryItem[]
  orderItems    OrderItem[]

  @@map("product_variants")
}

model InventoryItem {
  id          String          @id @default(cuid())
  storeId     String
  productId   String
  variantId   String?
  quantity    Float           @default(0)
  reservedQty Float           @default(0)
  location    String?         // Полка / секция

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, variantId])
  @@map("inventory_items")
}

model Customer {
  id             String    @id @default(cuid())
  name           String
  phone          String?   @unique
  email          String?
  cardNumber     String?   @unique
  bonusPoints    Float     @default(0)
  discountPercent Float    @default(0)
  totalSpent     Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders         Order[]

  @@map("customers")
}

model Shift {
  id            String      @id @default(cuid())
  storeId       String
  userId        String
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  status        ShiftStatus @default(OPEN)
  openingCash   Float       @default(0)
  closingCash   Float?
  cashDrawerIn  Float       @default(0) // Внесения
  cashDrawerOut Float       @default(0) // Изъятия
  totalSales    Float       @default(0)
  ordersCount   Int         @default(0)
  notes         String?

  store         Store       @relation(fields: [storeId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  orders        Order[]

  @@map("shifts")
}

model Order {
  id             String        @id @default(cuid())
  receiptNumber  String        @unique // Чек № 0001-20261025
  storeId        String
  userId         String
  shiftId        String?
  customerId     String?
  status         OrderStatus   @default(COMPLETED)
  subtotal       Float
  discountAmount Float         @default(0)
  discountRate   Float         @default(0) // %
  taxAmount      Float         @default(0)
  totalAmount    Float
  paidAmount     Float
  changeAmount   Float         @default(0)
  bonusApplied   Float         @default(0)
  bonusEarned    Float         @default(0)
  paymentMethod  PaymentMethod @default(CASH)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store          Store         @relation(fields: [storeId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  payments       Payment[]

  @@map("orders")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  productName String
  variantName String?
  sku         String
  unitPrice   Float
  costPrice   Float
  quantity    Float
  discountAmt Float           @default(0)
  totalPrice  Float

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  paymentMethod PaymentMethod
  amount        Float
  referenceCode String?       // Код транзакции эквайринга
  createdAt     DateTime      @default(now())

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model StockMovement {
  id            String       @id @default(cuid())
  storeId       String
  productId     String
  type          MovementType
  quantity      Float
  unitCost      Float?
  reference     String?      // Номер накладной или чека
  notes         String?
  createdAt     DateTime     @default(now())

  store         Store        @relation(fields: [storeId], references: [id])
  product       Product      @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // SALE, REFUND, SHIFT_OPEN, PRICE_CHANGE, INVENTORY_ADJ
  entity    String   // Order, Product, Shift
  entityId  String?
  details   Json?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
